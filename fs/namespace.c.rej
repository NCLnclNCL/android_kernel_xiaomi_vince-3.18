 #include <linux/magic.h>
 #include <linux/bootmem.h>
 #include <linux/task_work.h>
-#if defined(CONFIG_KSU_SUSFS_SUS_MOUNT) || defined(CONFIG_KSU_SUSFS_TRY_UMOUNT)
-#include <linux/susfs_def.h>
